# Expo SDK 57.0.12's expo-router bundles web-devtools packages
# (@expo/ui, vaul, Radix UI) that pull in a newer react-dom than the
# SDK's own root `react` pin satisfies. This is an upstream inconsistency
# in that specific release, not a real conflict in app code — those
# devtools packages aren't part of what ships to Android/iOS.
# See docs/DECISIONS.md for the full note. Revisit on the next Expo SDK
# patch/upgrade to see if it's been resolved upstream.
legacy-peer-deps=true
